# ---------------------------------------------------------------------------
# 编译产物（可重新生成，不含数据）
# ---------------------------------------------------------------------------
/qoder-proxy
/qoder-proxy.exe
/qoder-proxy-*
*.test
*.exe~
*~

# ---------------------------------------------------------------------------
# 运行时状态（含凭据，绝不能入库）
#
# accounts/ 是真实 access/refresh token 与面板口令摘要；
# usage/ 是请求流水（含账号 uid）；logs/ 可能含上游错误详情。
# ---------------------------------------------------------------------------
/accounts/
/usage/
/logs/
*.log
*.pid

# ---------------------------------------------------------------------------
# 中间产物 / 调试残留（代码运行时会生成）
#
# 写入路径举例：
#   <accounts>/settings.json.tmp              settings 原子写
#   <usage>/usage-summary.json.<pid>.<tid>.tmp usage 汇总原子写
#   <accounts>/admin/admin/agents-backup/     客户端配置备份
#   <任何路径>/*.qoder-proxy.tmp              agents 配置原子写
#   bridge_models.json.bak-<时间戳>           tools/add_qoder_models.py 备份
# ---------------------------------------------------------------------------
*.tmp
*.tmp.*
*.orig
*.rej
*.bak
*.bak-*
__pycache__/
*.py[cod]
.pytest_cache/

# ---------------------------------------------------------------------------
# 调试输出（手工排查时产生的临时文件）
# ---------------------------------------------------------------------------
*.out
*.diff
*.patch.log
debug-*
_diag-*
/tmp/

# ---------------------------------------------------------------------------
# 编辑器 / OS
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
